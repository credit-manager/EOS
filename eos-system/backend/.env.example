# EOS System — Environment Variables

# General
ENVIRONMENT=development
DEBUG=true
VERSION=1.0.0

# Database (required - no hardcoded passwords)
DATABASE_URL=postgresql+asyncpg://eos:CHANGE_ME@localhost:5432/eos_main
DATABASE_TEST_URL=postgresql+asyncpg://eos:CHANGE_ME@localhost:5432/eos_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Security (required - generate random 64+ char string)
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# AI
OPENAI_API_KEY=
HUGGINGFACE_MODEL=aubmindlab/bert-base-arabic-cased

# Egyptian Compliance
ETA_API_URL=https://api.eta.gov.eg
ETA_API_KEY=
NOSI_API_URL=https://api.nosi.gov.eg
NOSI_API_KEY=

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true
