POSTGRES_DB=eos_v2
POSTGRES_USER=eos_v2
POSTGRES_PASSWORD=CHANGE_ME_WITH_SECRET_MANAGER
EOS_AUTH_MODE=oidc
EOS_OIDC_ISSUER=https://identity.example.com/
EOS_OIDC_AUDIENCE=eos-api
EOS_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
EOS_ALLOWED_HOSTS=erp.example.com
EOS_CORS_ORIGINS=https://erp.example.com
EOS_METRICS_TOKEN=GENERATE_A_LONG_RANDOM_TOKEN

# Only required for controlled non-OIDC deployments; production security policy uses OIDC.
EOS_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Optional AI Composer (OpenAI-compatible / Qwen-compatible endpoint)
EOS_AI_BASE_URL=
EOS_AI_API_KEY=
EOS_AI_MODEL=
EOS_AI_TIMEOUT_SECONDS=30
