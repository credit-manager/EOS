# ═══════════════════════════════════════════════
# EOS Platform — Environment Configuration Template
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ───────────────────────────────────────────────
# Database Configuration (Required)
# ───────────────────────────────────────────────
DATABASE_URL=postgresql://eos_user:your_secure_password@localhost:5432/eos_platform
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# ───────────────────────────────────────────────
# Security & Authentication (Required)
# ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here_change_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ───────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
# Options: development, staging, production

# ───────────────────────────────────────────────
# CORS Settings (for frontend)
# ───────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# ───────────────────────────────────────────────
# Email Configuration (Optional but recommended)
# ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@eos-platform.com
SMTP_USE_TLS=true

# ───────────────────────────────────────────────
# Redis Cache (Optional for production)
# ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ───────────────────────────────────────────────
# File Storage
# ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ───────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json
# Options: json, text

# ───────────────────────────────────────────────
# Rate Limiting
# ───────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ───────────────────────────────────────────────
# AI Services (Optional)
# ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# ───────────────────────────────────────────────
# Payment Gateway (Optional for billing)
# ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ───────────────────────────────────────────────
# Multi-Tenancy
# ───────────────────────────────────────────────
DEFAULT_TENANT=default
ENABLE_MULTI_TENANCY=true

# ───────────────────────────────────────────────
# Feature Flags
# ───────────────────────────────────────────────
ENABLE_AI_COMPOSER=true
ENABLE_DYNAMIC_CRUD=true
ENABLE_WORKFLOW_ENGINE=true
ENABLE_BLOCKCHAIN=false
ENABLE_IOT=false

# ───────────────────────────────────────────────
# Monitoring & Metrics
# ───────────────────────────────────────────────
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090

# ───────────────────────────────────────────────
# Backup & Recovery (Production)
# ───────────────────────────────────────────────
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
# Cron format: minute hour day month weekday
BACKUP_RETENTION_DAYS=30

# ───────────────────────────────────────────────
# SSL/TLS (Production)
# ───────────────────────────────────────────────
SSL_CERT_FILE=/path/to/cert.pem
SSL_KEY_FILE=/path/to/key.pem

# ───────────────────────────────────────────────
# Session Management
# ───────────────────────────────────────────────
SESSION_COOKIE_NAME=eos_session
SESSION_COOKIE_SECURE=false
# Set to true in production with HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAME_SITE=lax

# ============================================
# 2FA ENCRYPTION (CRITICAL FOR SECURITY)
# ============================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Example: EOS_2FA_ENCRYPTION_KEY=1kkwTFZDcNme1mVcbInTknSeX1QZoSk8qmz-o_VgiOk=
EOS_2FA_ENCRYPTION_KEY=
