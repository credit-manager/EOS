# Copy to .env and fill in REAL values. Leave secrets blank: compose fails fast
# if POSTGRES_PASSWORD, JWT_SECRET, or CORS_ORIGINS are not provided.

# Database
POSTGRES_DB=2toeos
POSTGRES_USER=2toeos
# REQUIRED — generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Backend
APP_ENV=production
DATABASE_URL=postgresql+psycopg://2toeos:${POSTGRES_PASSWORD}@db:5432/2toeos
REDIS_URL=redis://redis:6379/0
# REQUIRED — generate with: openssl rand -hex 32
JWT_SECRET=
# REQUIRED — comma-separated origins allowed to call the API
CORS_ORIGINS=
RATE_LIMIT_AUTH_PER_MINUTE=60

# Frontend
VITE_API_URL=https://api.yourdomain.com