# EOS Platform environment template
# Copy to .env and replace placeholders. Never commit .env.

# Core
DATABASE_URL=postgresql://eos_user:CHANGE_ME@localhost:5432/eos_platform
EOS_AUTH_MODE=development
EOS_ENVIRONMENT=development
EOS_SECRET_KEY=CHANGE_ME_generate_at_least_32_random_characters
EOS_TEST_SECRET_KEY=CHANGE_ME_test_only
EOS_ALGORITHM=HS256
EOS_FRONTEND_URL=http://localhost:3000
DOMAIN=http://localhost:8001

# CORS / hosts
EOS_CORS_ORIGINS=["http://localhost:3000"]
EOS_ALLOWED_HOSTS=localhost,127.0.0.1
EOS_TRUSTED_HOSTS_ENABLED=false
EOS_TRUSTED_PROXIES=127.0.0.1/32

# Safety controls
EOS_DISABLE_DOCS=false
EOS_RATE_LIMIT_FAIL_CLOSED=true
EOS_MAX_BODY_BYTES=10485760

# Operational metrics (required in production)
EOS_METRICS_TOKEN=CHANGE_ME_random_metrics_token

# Email
EOS_EMAIL_PROVIDER=console
EOS_SMTP_HOST=
EOS_SMTP_USERNAME=
EOS_SMTP_PASSWORD=
EOS_FROM_EMAIL=

# Payments
# Development may use test integrations; production accepts disabled or stripe.
EOS_PAYMENT_MODE=test
EOS_STRIPE_SECRET_KEY=

# 2FA
EOS_2FA_ENABLED=false
EOS_2FA_ENCRYPTION_KEY=

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20
REDIS_URL=redis://localhost:6379/0

# AI providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
QWEN_API_KEY=

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Logging / observability
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090

# Database pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# SaaS
ENABLE_MULTI_TENANCY=true

# Feature flags
ENABLE_AI_COMPOSER=true
ENABLE_DYNAMIC_CRUD=true
ENABLE_WORKFLOW_ENGINE=true
ENABLE_BLOCKCHAIN=false
ENABLE_IOT=false

# Backups (configure production backups outside the application)
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
