# EOS Dynamic Business Platform — Environment Variables
# Copy to .env and replace every CHANGE_ME value before deployment.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=development
EOS_AUTH_MODE=test
EOS_APP_VERSION=1.0.0

# Production deployments MUST set ENVIRONMENT=production and
# EOS_AUTH_MODE=production explicitly.
EOS_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET
EOS_ALGORITHM=HS256
EOS_JWT_ISSUER=eos-dbp
EOS_JWT_AUDIENCE=eos-api

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://eos:CHANGE_ME@127.0.0.1:5432/eos_main
POSTGRES_USER=eos
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eos_main

# Production Docker Compose uses POSTGRES_* for the migration/database-owner
# role, plus separate least-privilege application and monitoring roles.
EOS_DB_RUNTIME_USER=eos_runtime
EOS_DB_RUNTIME_PASSWORD=CHANGE_ME_TO_RANDOM_RUNTIME_PASSWORD
EOS_DB_EXPORTER_USER=eos_exporter
EOS_DB_EXPORTER_PASSWORD=CHANGE_ME_TO_RANDOM_EXPORTER_PASSWORD

# -----------------------------------------------------------------------------
# API / browser security
# -----------------------------------------------------------------------------
EOS_FRONTEND_URL=http://localhost:3000
EOS_CORS_ORIGINS=["http://localhost:3000"]
EOS_ALLOWED_HOSTS=localhost,127.0.0.1
EOS_TRUSTED_HOSTS_ENABLED=false
EOS_MAX_BODY_BYTES=10485760
EOS_DISABLE_DOCS=false
EOS_ENABLE_DOCS=false
EOS_METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Encryption / secrets
# -----------------------------------------------------------------------------
# Generate a Fernet key with Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
# Required whenever EOS stores encrypted tenant/provider/2FA secrets.
EOS_SECRET_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# -----------------------------------------------------------------------------
# Email / payments
# -----------------------------------------------------------------------------
EOS_EMAIL_PROVIDER=console
EOS_SMTP_HOST=
EOS_SMTP_USERNAME=
EOS_SMTP_PASSWORD=
EOS_FROM_EMAIL=
EOS_PAYMENT_MODE=
EOS_STRIPE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Production web / TLS
# -----------------------------------------------------------------------------
DOMAIN=example.com
ACME_EMAIL=ops@example.com

# -----------------------------------------------------------------------------
# Platform operations
# -----------------------------------------------------------------------------
EOS_LOG_LEVEL=info
EOS_LOG_FORMAT=json
REDIS_URL=redis://127.0.0.1:6379/0
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_TO_RANDOM_GRAFANA_PASSWORD
GRAFANA_URL=http://localhost:3000
