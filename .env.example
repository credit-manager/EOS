# EOS Dynamic Business Platform — Environment Variables
# Copy to .env for local development, then replace every CHANGE_ME value.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Local development explicitly uses test authentication.
ENVIRONMENT=development
EOS_AUTH_MODE=test
EOS_APP_VERSION=1.0.0

# Production deployments MUST set ENVIRONMENT=production and
# EOS_AUTH_MODE=production explicitly.
# EOS_SECRET_KEY must be a random value of at least 32 characters.
EOS_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET
EOS_ALGORITHM=HS256
EOS_JWT_ISSUER=eos-dbp
EOS_JWT_AUDIENCE=eos-api

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://eos:CHANGE_ME@127.0.0.1:5432/eos_main
POSTGRES_USER=eos
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eos_main

# -----------------------------------------------------------------------------
# API / browser security
# -----------------------------------------------------------------------------
# JSON array of exact browser origins. Do not use '*' with credentials.
EOS_FRONTEND_URL=http://localhost:3000
EOS_CORS_ORIGINS=["http://localhost:3000"]
EOS_ALLOWED_HOSTS=localhost,127.0.0.1
EOS_TRUSTED_HOSTS_ENABLED=false
EOS_MAX_BODY_BYTES=10485760

# API documentation and Prometheus metrics are convenient locally.
# They are disabled by default in production and must be explicitly enabled.
EOS_DISABLE_DOCS=false
EOS_ENABLE_DOCS=false
EOS_METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Email / payments
# -----------------------------------------------------------------------------
# Local development can use the application's test/console provider.
EOS_EMAIL_PROVIDER=console
EOS_SMTP_HOST=
EOS_SMTP_USERNAME=
EOS_SMTP_PASSWORD=
EOS_FROM_EMAIL=

# Production requires Stripe mode and a live secret key.
EOS_PAYMENT_MODE=
EOS_STRIPE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Platform operations
# -----------------------------------------------------------------------------
EOS_LOG_LEVEL=info
EOS_LOG_FORMAT=json
REDIS_URL=redis://127.0.0.1:6379/0
