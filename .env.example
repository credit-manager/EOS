# EOS Dynamic Business Platform — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env files.

# ═══════════════════════════════════════════════════
# DATABASE (required)
# ═══════════════════════════════════════════════════
DATABASE_URL=postgresql://eos:CHANGE_ME@127.0.0.1:5432/eos_main

# ═══════════════════════════════════════════════════
# AUTH (required for production)
# ═══════════════════════════════════════════════════
EOS_AUTH_MODE=test
EOS_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS_MINIMUM
EOS_ALGORITHM=HS256
EOS_TEST_SECRET_KEY=test_secret_key_for_development_only_12345678901234567890
EOS_JWT_ISSUER=eos-dbp
EOS_JWT_AUDIENCE=eos-api

# ═══════════════════════════════════════════════════
# CORS & SECURITY
# ═══════════════════════════════════════════════════
EOS_CORS_ORIGINS=["http://localhost:3000"]
EOS_ALLOWED_HOSTS=localhost,127.0.0.1
EOS_TRUSTED_HOSTS_ENABLED=false
EOS_TRUSTED_PROXY_IPS=

# ═══════════════════════════════════════════════════
# FEATURES
# ═══════════════════════════════════════════════════
EOS_DISABLE_DOCS=false
ENVIRONMENT=development

# ═══════════════════════════════════════════════════
# 2FA (generate a Fernet key for production)
# ═══════════════════════════════════════════════════
EOS_2FA_ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════
# EXTERNAL SERVICES
# ═══════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EOS_FRONTEND_URL=http://localhost:3000

# ═══════════════════════════════════════════════════
# METRICS
# ═══════════════════════════════════════════════════
EOS_METRICS_TOKEN=CHANGE_ME_TO_RANDOM_16_CHARS
