# EOS Dynamic Business Platform — PRODUCTION Environment Template
# Copy this to .env.production and fill in ALL values
# NEVER commit the filled .env.production to version control

# ═══════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════
DATABASE_URL=postgresql://eos_prod:CHANGE_ME_STRONG_PASSWORD@db:5432/eos_production

# ═══════════════════════════════════════════════
# AUTH — MUST be production
# ═══════════════════════════════════════════════
EOS_AUTH_MODE=production
EOS_SECRET_KEY=GENERATE_WITH: python -c "import secrets; print(secrets.token_urlsafe(48))"
EOS_ALGORITHM=HS256
EOS_TOKEN_EXPIRE_MINUTES=60

# ═══════════════════════════════════════════════
# EMAIL — Configure your SMTP provider
# ═══════════════════════════════════════════════
EOS_EMAIL_PROVIDER=smtp
EOS_SMTP_HOST=smtp.your-provider.com
EOS_SMTP_PORT=587
EOS_SMTP_USERNAME=your-smtp-username
EOS_SMTP_PASSWORD=your-smtp-password
EOS_FROM_EMAIL=noreply@your-domain.com
EOS_FROM_NAME=EOS Platform

# ═══════════════════════════════════════════════
# PAYMENT — Stripe Live Mode
# ═══════════════════════════════════════════════
EOS_PAYMENT_MODE=stripe
EOS_STRIPE_SECRET_KEY=sk_live_CHANGE_ME_TO_REAL_STRIPE_KEY

# ═══════════════════════════════════════════════
# FRONTEND URL
# ═══════════════════════════════════════════════
EOS_FRONTEND_URL=https://your-domain.com

# ═══════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════
EOS_CORS_ORIGINS=["https://your-domain.com"]
EOS_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ═══════════════════════════════════════════════
# POSTGRESQL (Docker)
# ═══════════════════════════════════════════════
POSTGRES_USER=eos_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=eos_production

# ═══════════════════════════════════════════════
# DOMAIN
# ═══════════════════════════════════════════════
DOMAIN=your-domain.com
LETSENCRYPT_EMAIL=admin@your-domain.com